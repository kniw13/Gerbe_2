<Page x:Class="Demka_Gerber_2.Pages.ProsmotrBook"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Demka_Gerber_2.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProsmotrBooks"
       Loaded="Page_Loaded">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="7*"/>
            <RowDefinition Height="43*"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="txt_name" Grid.Row="0" Width="200" Height="30" HorizontalAlignment="Left" TextChanged="txt_name_TextChanged"/>
        <ComboBox x:Name="cmb_Authors" Grid.Row="0" Width="200" Height="30" HorizontalAlignment="Left" Margin="210,0,0,0" SelectionChanged="cmb_Authors_SelectionChanged">
            
        </ComboBox>
        <ComboBox x:Name="cmb_Genre" Grid.Row="0" Width="200" Height="30" HorizontalAlignment="Left" Margin="420,0,0,0" SelectionChanged="cmb_Genre_SelectionChanged"/>
        <Button x:Name="btn_Dobavit" Background="Blue" Content="Добавить книгу" Width="150" Height="30" Margin="630,0,0,0" Click="btn_Dobavit_Click"/>
        <ListView x:Name="lv_Books" Grid.Row="1" HorizontalAlignment="Stretch" MouseDoubleClick="lv_Books_MouseDoubleClick">
            <ListView.ItemTemplate>
                <DataTemplate>

                    <Border BorderBrush="Black" BorderThickness="5" CornerRadius="3" Margin="0,0,0,5" HorizontalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2"/>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="1" >
                                <Run Text="Название:"/>
                                <Run Text="{Binding BookName}"/>
                            </TextBlock>
                            <TextBlock Grid.Row="2">
                                <Run Text="Автор:"/>
                                <Run Text="{Binding AuthorName}"/>
                            </TextBlock>
                            <TextBlock Grid.Row="3" >
                                  <Run Text="Дата написание:"/>
                                  <Run Text="{Binding Date}"/>
                            </TextBlock>
                            <TextBlock Grid.Row="4" >
                                <Run Text="Жанр:"/>
                                <Run Text="{Binding Genre}"/>
                            </TextBlock>
                            <TextBlock Grid.Row="6" >
                                 <Run Text="Статус Книги:"/>
                                 <Run Text="{Binding StatusBook}"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>
    </Grid>
</Page>
