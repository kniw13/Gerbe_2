<Page x:Class="Demka_Gerber_2.Pages.REACTORCREATEBOOK"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Demka_Gerber_2.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="REACTORCREATEBOOK">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="9*"/>
        </Grid.RowDefinitions>

        <Label x:Name="lb_Name" VerticalAlignment="Top" HorizontalAlignment="Center" Grid.Row="0"/>
        <Button x:Name="btn_Nazad" VerticalAlignment="Top" HorizontalAlignment="Right" Grid.Row="0" Content="Назад" Background="MediumOrchid" Width="150" Click="btn_Nazad_Click"/>
        <StackPanel Grid.Row="1">
            <TextBlock Text="Введите имя книги" FontSize="25"/>
            <TextBox x:Name="txt_name" Width="150" Height="20" HorizontalAlignment="Left"/>
            <TextBlock Text="Выберите автора книги" FontSize="25"/>
            <ComboBox x:Name="cmb_autor" Width="150" Height="20" HorizontalAlignment="Left"  />
            <TextBlock Text="Выберите жанр книги" FontSize="25"/>
            <ComboBox x:Name="cmb_genre" Width="150" Height="20" HorizontalAlignment="Left"  />
            <TextBlock Text="Выберите дату написания книги" FontSize="25"/>
            <TextBox x:Name="txt_Date" Width="150" Height="20" HorizontalAlignment="Left" />
            <TextBlock Text="Выберите Статус книги" FontSize="25"/>
            <ComboBox x:Name="cmb_status" Width="150" Height="20" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btn_Save" Content="Сохранить" Background="Green" HorizontalAlignment="Left" Click="btn_Save_Click"/>
                <Button x:Name="btn_Delete"   Content="Удалить" Background="Red" HorizontalAlignment="Left" Margin="10,0,0,0" Click="btn_Delete_Click"/>
            </StackPanel>
          
        </StackPanel>

    </Grid>
</Page>
